# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# DATABASE_URL: PostgreSQL connection string for Supabase migrations/direct access
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"

# REDIS_URL: Redis cache & real-time broker connection
REDIS_URL="redis://localhost:6379"

# STATE_EOC_DISTRICT: Default Pilot District or STATE for EOC node
STATE_EOC_DISTRICT="STATE_CONTROL"

# DISASTER_MODE: Default system operational mode (NORMAL | ALERT | RED_ALERT)
DEFAULT_DISASTER_MODE="NORMAL"
