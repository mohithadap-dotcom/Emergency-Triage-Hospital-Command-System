# Copy this file to .env. Keep real credentials out of version control.

# Optional: enables Gemini-backed triage and command recommendations.
# Without it, Rakshak AI uses deterministic fallback logic.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# DATABASE_URL: PostgreSQL connection string for Supabase migrations/direct access
DATABASE_URL=""

# REDIS_URL: Redis cache & real-time broker connection
REDIS_URL="redis://localhost:6379"

# Optional: enables Google Maps-backed views where configured.
GOOGLE_MAPS_PLATFORM_KEY=""

# STATE_EOC_DISTRICT: Default Pilot District or STATE for EOC node
STATE_EOC_DISTRICT="STATE_CONTROL"

# DISASTER_MODE: Default system operational mode (NORMAL | ALERT | RED_ALERT)
DEFAULT_DISASTER_MODE="NORMAL"
